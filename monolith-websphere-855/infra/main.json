                },
                "template": {
                  "containers": [
                    {
                      "name": "customerorder-api",
                      "image": "[format('{0}/customerorder-api:latest', parameters('acrLoginServer'))]",
                      "resources": {
                        "cpu": "[json('0.5')]",
                        "memory": "1Gi"
                      },
                      "env": [
                        {
                          "name": "WEBSITES_PORT",
                          "value": "9080"
                        },
                        {
                          "name": "JAVA_TOOL_OPTIONS",
                          "value": "-javaagent:/opt/otel/opentelemetry-javaagent.jar"
                        },
                        {
                          "name": "OTEL_SERVICE_NAME",
                          "value": "customerorder-api"
