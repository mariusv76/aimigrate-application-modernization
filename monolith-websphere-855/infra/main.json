                        {
                          "name": "AZURE_KEYVAULT_ENDPOINT",
                          "value": "[variables('keyVaultUrl')]"
                        },
                        {
                          "name": "AZURE_TENANT_ID",
                          "value": "[parameters('tenantId')]"
                        },
                        {
                          "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                          "secretRef": "app-insights-connection-string"
