    <!-- Logging Configuration -->
    <logging 
        traceSpecification="*=info:org.pwte.example.*=all:com.ibm.ws.jpa.*=info"
        maxFileSize="100"
        maxFiles="10"
        consoleLogLevel="INFO"
        consoleFormat="simple"
        consoleSource="message,trace,accessLog,ffdc,audit">
    </logging>

    <!-- Application Manager Configuration -->
    <applicationManager autoExpand="true" startTimeout="300s"/>

    <!-- HTTP Session Configuration -->
    <httpSession 
        cookieHttpOnly="true" 
        cookieSecure="true"
        cookieSameSite="Strict"
        invalidationTimeout="30m"
        securityIntegrationEnabled="false"/>

    <!-- Web Container Configuration -->
    <webContainer 
        deferServletLoad="false"
        disallowServeServletsByClassName="true"/>

    <!-- CORS Configuration (for development/testing) -->
    <cors 
        domain="/"
        allowedOrigins="http://localhost:*,https://localhost:*"
        allowedMethods="GET,POST,PUT,DELETE,OPTIONS"
        allowedHeaders="*"
        maxAge="3600"/>

    <!-- Security Configuration -->
    <applicationSecurity/>
    
    <!-- Optional: Basic User Registry for testing -->
    <!-- Uncomment for development if authentication is needed -->
    <!--
