<?xml version="1.0" encoding="UTF-8"?>
<server description="Customer Order Services Open Liberty Server">

    <!-- Enable Liberty features -->
    <featureManager>
        <!-- Jakarta EE 10 Full Platform -->
        <feature>jakartaee-10.0</feature>
        
        <!-- MicroProfile 6.0 for cloud-native patterns -->
        <feature>microProfile-6.0</feature>
    </featureManager>

    <!-- HTTP Endpoint Configuration -->
    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="${default.http.port}"
                  httpsPort="${default.https.port}"
                  host="*">
        <httpOptions removeServerHeader="true"/>
    </httpEndpoint>

    <!-- Application Configuration -->
    <application id="CustomerOrderServicesApp" 
                 location="CustomerOrderServicesApp.ear"
                 type="ear"
                 name="CustomerOrderServicesApp">
        <!-- Use parent-last classloading for application isolation -->
        <classloader delegation="parentLast"/>
    </application>

