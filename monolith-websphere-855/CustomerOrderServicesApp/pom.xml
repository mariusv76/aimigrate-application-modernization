<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.pwte.example</groupId>
  <artifactId>CustomerOrderServicesApp</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>CustomerOrderServicesApp</name>
  <packaging>ear</packaging>
  <parent>
    <artifactId>project</artifactId>
    <groupId>org.pwte.example</groupId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../CustomerOrderServicesProject</relativePath>
  </parent>
  <dependencies>
    <dependency>
      <groupId>org.pwte.example</groupId>
      <artifactId>CustomerOrderServices</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <type>ejb</type>
    </dependency>
    <dependency>
      <groupId>org.pwte.example</groupId>
      <artifactId>CustomerOrderServicesWeb</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>org.pwte.example</groupId>
      <artifactId>CustomerOrderServicesTest</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <type>war</type>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
      <!-- The ear plugin must include the definition for "modules", for any				modules that are needed to be included in the EAR file, you need to specify				them one by one, e.g. "ejbModule", "webModule", "jarModule" and "appClientModule". -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-ear-plugin</artifactId>
        <version>2.6</version>
        <configuration>
          <version>5</version>
          <generateModuleId>true</generateModuleId>
          <modules>
            <ejbModule>
              <groupId>org.pwte.example</groupId>
              <artifactId>CustomerOrderServices</artifactId>
            </ejbModule>
            <webModule>
              <groupId>org.pwte.example</groupId>
              <artifactId>CustomerOrderServicesWeb</artifactId>
              <context-root>CustomerOrderServicesWeb</context-root>
            </webModule>
            <webModule>
              <groupId>org.pwte.example</groupId>
              <artifactId>CustomerOrderServicesTest</artifactId>
              <context-root>CustomerOrderServicesTest</context-root>
            </webModule>
          </modules>
          <earSourceDirectory>${basedir}</earSourceDirectory>
          <earSourceIncludes>**/ibm-application-bnd.xml</earSourceIncludes>
          <earSourceExcludes>**/target/**</earSourceExcludes>
          <security>
            <security-role>
              <role-name>SecureShopper</role-name>
            </security-role>
          </security>
        </configuration>
      </plugin>
      <!-- Open Liberty Maven Plugin -->
      <plugin>
        <groupId>io.openliberty.tools</groupId>
        <artifactId>liberty-maven-plugin</artifactId>
        <version>3.10.3</version>
        <configuration>
          <!-- Server configuration -->
          <serverName>defaultServer</serverName>
          <serverXmlFile>${project.basedir}/../Deployment/server.xml</serverXmlFile>
          <bootstrapPropertiesFile>${project.basedir}/../Deployment/bootstrap.properties</bootstrapPropertiesFile>
          
          <!-- Liberty runtime -->
          <runtimeArtifact>
            <groupId>io.openliberty</groupId>
            <artifactId>openliberty-runtime</artifactId>
            <version>24.0.0.11</version>
            <type>zip</type>
          </runtimeArtifact>
          
          <!-- Application deployment -->
          <appsDirectory>apps</appsDirectory>
          <looseApplication>false</looseApplication>
          <stripVersion>true</stripVersion>
          <installAppPackages>project</installAppPackages>
          
          <!-- Development mode settings -->
          <hotTests>true</hotTests>
          <skipTestServer>false</skipTestServer>
          
          <!-- Debugging -->
          <jvmOptions>
            <param>-Xms256m</param>
            <param>-Xmx1024m</param>
          </jvmOptions>
        </configuration>
        <executions>
          <!-- Install Liberty server during prepare-package phase -->
          <execution>
            <id>install-liberty</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>install-server</goal>
            </goals>
          </execution>
          <!-- Create Liberty server during package phase -->
          <execution>
            <id>create-server</id>
            <phase>package</phase>
            <goals>
              <goal>create</goal>
            </goals>
          </execution>
          <!-- Deploy application during package phase -->
          <execution>
            <id>deploy-app</id>
            <phase>package</phase>
            <goals>
              <goal>deploy</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
